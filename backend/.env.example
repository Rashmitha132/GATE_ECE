# Core Security Credentials
SECRET_KEY=your-production-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SECURITY_SALT=your-security-salt-here

# Production Domain Whitelist (e.g. https://gate-ece.gsssietw.ac.in)
ALLOWED_ORIGINS=https://your-production-domain.com

# Database Configuration
# Default is local SQLite. For Supabase / Production PostgreSQL, set:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./gate_ece.db

# Department / College Mail Configuration (For sending OTPs & Welcome Credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gsss.gate.ece@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=GSSSIETW GATE ECE Portal
PORTAL_URL=http://localhost:5173

# Optional Supabase Storage & Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key-here
